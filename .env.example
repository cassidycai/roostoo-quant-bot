# ---------------------------------------------------------------------------
# Roostoo Quant Trading Hackathon bot -- configuration template.
# Copy to `.env` and fill in. `.env` is git-ignored: never commit real keys.
#
# Portfolio defaults below already match the team's playbook (Rules 7-12).
# ---------------------------------------------------------------------------

# --- Credentials (issued by Roostoo / the organisers) -----------------------
ROOSTOO_API_KEY=
ROOSTOO_SECRET_KEY=
ROOSTOO_BASE_URL=https://mock-api.roostoo.com

# Set to 1 to run against the built-in simulated exchange (no keys, no network).
ROOSTOO_MOCK=0

# --- Rule 1: universe -------------------------------------------------------
# Comma separated. Leave EMPTY to auto-discover every tradable pair and rank by
# 24h turnover. Listing pairs explicitly keeps the ranking *within* that list.
ROOSTOO_PAIRS=
ROOSTOO_MAX_PAIRS=8
MAX_SPREAD_BPS=10            # Rule 1 clause 2: reject spread above 0.1%
# Depth within +/-0.5% of mid must exceed this ($X in Rule 1).
DEPTH_TARGET_NOTIONAL=2000
DEPTH_BAND_PCT=0.005
# none   = do not check depth (correct for a historical backtest)
# binance= real L2 depth from Binance as a liquidity proxy (live only)
# roostoo= a Roostoo depth path, once the organisers confirm one exists
# ticker = rough estimate from 24h turnover (an assumption, not a measurement)
# The organisers confirmed the mock venue's prices follow Binance, so Binance's L2
# book is now a legitimate proxy for "is this asset liquid". Caveat: it measures
# MARKET liquidity, not the mock venue's own depth.
# WARNING: binance FAILS CLOSED -- if Binance's depth endpoint is unreachable,
# every pair is excluded and the bot silently stops trading. That is a bad failure
# mode inside a scored window that needs >=8 active trading days, so `none` ships
# as the default. Flip to `binance` after `run_live.py --check` confirms depth
# connectivity, and watch the journal for "depth unavailable (fail-closed)".
DEPTH_PROVIDER=none
ROOSTOO_DEPTH_PATH=
DEPTH_LIQUIDITY_SHARE=0.02   # only used by DEPTH_PROVIDER=ticker

# Cross-venue basis alarm. The venue tracks Binance, so a wide basis means a wrong
# symbol (USDT vs USD) or a stale feed -- not "a related market". Pairs beyond the
# threshold are excluded for that bar and every reading is journalled. Unlike the
# depth check this FAILS OPEN, because a Binance outage must not stop trading.
# Unset uses 0.01 (1%); tighten to ~0.002 once you have a day of real basis data.
BASIS_MAX_PCT=0.01

# --- Loop ------------------------------------------------------------------
BAR_SECONDS=1800             # 30-minute bars: the unit of Rules 2-6
# Keep >= 30: the rules forbid HFT and the exchange throttles request bursts.
LOOP_INTERVAL_SEC=60
HISTORY_WINDOW=500
REQUEST_TIMEOUT_SEC=15
MAX_RETRIES=3
MIN_REQUEST_INTERVAL_SEC=0.25

# --- Capital & portfolio risk (Rules 7-12) ---------------------------------
INITIAL_CAPITAL=100000
RISK_PER_TRADE_PCT=0.005     # Rule 7: max loss per trade = 0.5% of portfolio
MAX_PAIR_WEIGHT=0.15         # Rule 8: no single coin above 15% of NAV
MAX_GROSS_EXPOSURE=0.60      # Rule 9: gross exposure <= 60% of NAV
MAX_OPEN_POSITIONS=4         # Rule 10: at most four coins at once
MAX_DAILY_LOSS_PCT=0.02      # Rule 11: -2% day halts new entries
TRADING_DAY_OFFSET_HOURS=8   # Rule 11 day boundary: 00:00-23:59 UTC+8
COOLDOWN_BARS=2              # Rule 12: 2 bars (1h) after an exit
MIN_ORDER_NOTIONAL=25        # skip dust orders; fees eat them

# --- Protective exits (Rules 5-6; owned by a teammate -- tune or disable) ---
# To DISABLE one of these, use an explicit token: none, null, off, disabled or no.
# Leaving the value EMPTY does NOT disable it -- `_get()` maps "" to the default
# below, so `STOP_ATR_MULT=` silently keeps a 1.5x ATR stop.
STOP_ATR_MULT=1.5            # Rule 5: stop at 1.5 x ATR(14); `none` disables
MAX_HOLD_BARS=12             # Rule 6: time stop after 12 bars (6h); `none` disables
STOP_LOSS_PCT=none               # percentage-stop fallback when ATR is unavailable
TAKE_PROFIT_PCT=none             # empty = disabled (not in the playbook)
TRAILING_STOP_PCT=none           # empty = disabled (not in the playbook)
# With a stop configured, an entry whose stop distance cannot be computed (a
# missing or non-finite ATR) is REFUSED rather than approved at full size. Without
# this, an uncomputable stop silently produced the *largest* position the caps
# allow, with no stop at all -- the opposite of risk-first. Set to 0 to restore
# the old caps-only fallback (it is reported in the journal as "+no_stop").
REFUSE_ENTRY_WITHOUT_STOP=1

# --- Execution: passive (maker) entries ------------------------------------
# 1 = post entries as resting limit orders instead of market orders. The bot
# otherwise pays the taker fee AND crosses the spread on every entry.
# Measured: the round trip goes 0.30% -> 0.25%, worth about +0.047% per trade --
# real, and about a seventh of the current loss, not a fix. See FINDINGS 6b.1.
# Exits always stay market: a stop that rests is not a stop.
# CAUTION: the 95-99% fill rate behind that number comes from OHLC bars, where
# "the low reached my limit" is not "my order was first in the queue". Watch
# `orders_posted` against `orders_cancelled` in the stats/journal for the real
# rate before trusting the saving.
LIMIT_ENTRIES=0
# How far below the mid to bid. 0 bids at the mid, where the signal was born.
LIMIT_ENTRY_OFFSET_BPS=0
# Cancel an unfilled bid after this many bars, so capital is not locked up in an
# entry the strategy no longer wants.
LIMIT_ENTRY_TIMEOUT_BARS=1
# Hard kill switch: flatten everything and halt for the rest of the run. The halt
# is persisted, so a restart cannot recover it -- `run_live.py` therefore exits
# with status 3, which the systemd unit declares a clean stop (SuccessExitStatus)
# so `Restart=always` does not thrash on a deliberately halted bot. Resetting
# requires editing journal/engine_state.json by hand.
MAX_DRAWDOWN_PCT=0.20

# --- Costs (per the published rulebook; used by the backtester) ------------
TAKER_FEE=0.001
MAKER_FEE=0.0005
SLIPPAGE_BPS=5

# --- Strategy (Rules 2-3, with Rule 4's deviation gate) --------------------
STRATEGY=roostoo.strategies.mean_reversion:MeanReversionStrategy
# Rule 2: window=48 bars (24h), z_entry=2.0, exits at -0.25 / +0.25.
# Rule 3: adx_period=14, adx_max=25.
# The four supplementary filters default to false -- switch them on one at a
# time and keep only the ones that improve the out-of-sample backtest.
#
# `enforce_min_deviation` is ON here, which is NOT the code default. It is Rule
# 4's gate: without it the bot takes moves too small to cover the 0.2% round
# trip. Measured on the 2026-05-31..09-28 dataset (120d, 8 pairs,
# `run_backtest.py --oos-frac 0.25`):
#     gate off (old default)   in-sample -17.50%   OOS -12.61%   842 fills, 11,273 fees
#     gate on                  in-sample  -5.13%*  OOS  -5.27%   326 fills,  4,715 fees
# (*that -5.13% also has allow_short=0. With the short leg left on it is
#  -13.45%, which is what docs/FINDINGS.md section 1 reports.)
#
# `allow_short` is deliberately LEFT AT TRUE, matching the code default and
# Rule 2's text, which describes a short entry. The measurement says turning it
# off is worth a further ~8 points in-sample -- the short leg's gross P&L is
# -4,283 against -46 for the long book, because crypto drifted up over this
# window and fading a +2sigma stretch is fighting the trend. That is a team
# decision, not a config detail: see docs/FINDINGS.md section 3, and note that
# the v6 short endpoints document `this competition does not allow short
# positions`. Flip the value here once the team agrees.
#
# `direction` makes that same observation systematic. A +2sigma stretch that keeps
# going IS the trend, so fading it is fighting it. On a 2-year, 10-pair dataset
# with the final 183 days held out: entering WITH the stretch is -2.51%
# out-of-sample against -19.25% for fading it, at about a fifth of the drawdown.
# `reversion` restores the fade. Neither is profitable (-1.51% is the best
# out-of-sample cell), and the entry and the exit must move together, so read
# docs/FINDINGS.md section 9 before changing one without the other.
STRATEGY_PARAMS={"window":48,"z_entry":2.0,"z_exit_long":-0.25,"z_exit_short":0.25,"adx_period":14,"adx_max":25.0,"min_abs_deviation":0.006,"enforce_min_deviation":true,"allow_short":true,"direction":"momentum","min_delta_z":0.5,"enable_return_shock_filter":false,"enable_vwap_filter":false,"enable_relative_volume_filter":false,"enable_vol_expansion_filter":false}

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
JOURNAL_DIR=journal
LOG_DIR=logs

# --- Metrics convention ----------------------------------------------------
# Ratios are annualised from DAILY equity marks (365 for a 24/7 crypto venue).
# The live tracker only uses this once there are at least two UTC daily marks; on
# the first day it reports the level figures (equity, return, drawdown, win rate)
# without annualising anything, rather than extrapolating a per-loop grid.
PERIODS_PER_YEAR=365
RISK_FREE_RATE=0
